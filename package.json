{
  "name": "nuxt-customer-portal-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --write . && eslint . --fix && prettier --write . && eslint .",
    "format:check": "prettier --check . && eslint .",
    "lint": "eslint .",
    "migrate": "tsx scripts/migrate.ts",
    "operator:create": "tsx scripts/create-operator.ts",
    "postinstall": "nuxt prepare",
