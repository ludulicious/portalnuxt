DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portal_saas
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
CONTROL_PLANE_ENCRYPTION_KEY=
OPERATOR_EMAILS=
ACCESS_REQUEST_NOTIFICATION_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT=production
# Repository location only. Stable release tags are discovered and digest-pinned.
PORTAL_IMAGE=ghcr.io/example/nuxt-customer-portal
REGISTRY_USERNAME=
REGISTRY_TOKEN=
PORTAL_BASE_DOMAIN=portals.example.com

# Administrative connection used only by the database provider to create a
# least-privilege role and database for each portal instance.
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@postgres.example.com:5432/postgres

# Optional private endpoint injected into portal containers. Credentials and
# the database name are replaced with the dedicated tenant values.
POSTGRES_RUNTIME_URL=postgresql://postgres:postgres@postgres.internal:5432/postgres
